#!/usr/bin/with-contenv bashio
set -euo pipefail
umask 077

CONFIG_PATH="/data/options.json"
export CONFIG_PATH

if [[ ! -r "${CONFIG_PATH}" ]]; then
  bashio::log.fatal "Missing Home Assistant options file: ${CONFIG_PATH}"
  exit 1
fi

while IFS= read -r -d '' key && IFS= read -r -d '' value; do
  printf -v "${key}" '%s' "${value}"
  export "${key}"
done < <(python3 /usr/local/bin/gmc_runtime_env.py bridge)

MQTT_HOST="$(bashio::services mqtt 'host')"
MQTT_PORT="$(bashio::services mqtt 'port')"
MQTT_USERNAME="$(bashio::services mqtt 'username')"
MQTT_PASSWORD="$(bashio::services mqtt 'password')"
export MQTT_HOST MQTT_PORT MQTT_USERNAME MQTT_PASSWORD

PROFILE_COUNT="$(python3 -c 'import json,os; print(len(json.loads(os.environ["DEVICES_JSON"])))')"
bashio::log.info "Automatic GMC port and baud-rate detection enabled (${PROFILE_COUNT} configured device profile(s))"
bashio::log.info "Serial devices will be connected automatically; newly attached GMC counters are rescanned every 15 seconds"
exec python3 /usr/local/bin/gmc_auto_bridge.py
